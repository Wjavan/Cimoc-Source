    "ruleChapterUrl": "@css:a@href",
    "ruleContentUrl": "@js:result",
    "ruleComicContent": "$function parseImages(){var s=DM5_CID;var m=DM5_MID;if(!s||!m)return[];var url='http://m.dm5.com/chapterfun.ashx?cid='+s+'&mid='+m;var xhr=new XMLHttpRequest();xhr.open('GET',url,false);xhr.send();if(xhr.status==200){var data=JSON.parse(xhr.responseText);var imgs=[];for(var i=0;i<data.length;i++)imgs.push(data[i].url);return imgs;}return [];}",
